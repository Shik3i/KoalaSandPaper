{
  "name": "koalasandpaper",
  "version": "0.1.0",
  "private": true,
  "author": "KoalaSandPaper",
  "license": "UNLICENSED",
  "description": "A quiet, kinetic sand studio. Based on KoalaSand granular physics.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "package:desktop": "npm run build && electron-builder --dir",
    "package:wallpaper": "npm run build && node scripts/wallpaper.mjs"
  },
  "build": {
    "appId": "net.koalastuff.sandpaper",
    "productName": "KoalaSandPaper",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "vendor/koalasand/LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
