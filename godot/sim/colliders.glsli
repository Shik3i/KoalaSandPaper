// Analytic SDF machine colliders (kinematic bodies with primitives).
// Requires common.glsli.

void body_pose(uint b, float t, out vec2 pos, out float ang, out vec2 vel, out float om) {
	vec4 p = BODY[2u * b];
	vec4 v = BODY[2u * b + 1u];
	vel = v.xy;
	om = v.z;
	pos = p.xy + v.xy * t;
	ang = p.z + v.z * t;
	if (p.w > 0.5) {
		// Force-limited body (sensor p.w - 1): commanded pose plus its yield.
		uint s = uint(p.w) - 1u;
		vec2 axis = vec2(ACC[SENSE_CFG + 4u * s], ACC[SENSE_CFG + 4u * s + 1u]);
		vec2 y = yield_now(s);
		pos += axis * y.x;
		vel += axis * y.y;
	}
}

// q is in the body's local frame.
float prim_sdf(Prim pr, vec2 q) {
	if (pr.head.z > 1u) {
		float sector = 6.28318530718 / float(pr.head.z);
		float k = round((atan(q.y, q.x) - pr.xf.w) / sector);
		q = rot(-k * sector) * q;
	}
	q = rot(-pr.xf.z) * (q - pr.xf.xy);
	float d;
	uint type = pr.head.x;
	if (type == PRIM_CIRCLE) {
		d = length(q) - pr.shape.x;
	} else if (type == PRIM_CAPSULE) {
		q.x -= clamp(q.x, -pr.shape.x, pr.shape.x);
		d = length(q) - pr.shape.y;
	} else if (type == PRIM_BOX) {
		vec2 e = abs(q) - pr.shape.xy + pr.shape.z;
		d = length(max(e, 0.0)) + min(max(e.x, e.y), 0.0) - pr.shape.z;
	} else {
		// Arc symmetric about local +y, radius ra, half thickness rb, half aperture shape.z.
		vec2 sc = vec2(sin(pr.shape.z), cos(pr.shape.z));
		q.x = abs(q.x);
		d = ((sc.y * q.x > sc.x * q.y) ? length(q - sc * pr.shape.x) : abs(length(q) - pr.shape.x)) - pr.shape.y;
	}
	return (pr.head.w & 1u) != 0u ? -d : d;
}

// Signed distance and its exact gradient (unit, body-local frame) in one pass.
float prim_sdf_grad(Prim pr, vec2 q, out vec2 g) {
	float ks = 0.0;
	if (pr.head.z > 1u) {
		float sector = 6.28318530718 / float(pr.head.z);
		ks = round((atan(q.y, q.x) - pr.xf.w) / sector) * sector;
		q = rot(-ks) * q;
	}
	q = rot(-pr.xf.z) * (q - pr.xf.xy);
	float d;
	uint type = pr.head.x;
	if (type == PRIM_CIRCLE) {
		float l = max(length(q), 1e-12);
		d = l - pr.shape.x;
		g = q / l;
	} else if (type == PRIM_CAPSULE) {
		q.x -= clamp(q.x, -pr.shape.x, pr.shape.x);
		float l = max(length(q), 1e-12);
		d = l - pr.shape.y;
		g = q / l;
	} else if (type == PRIM_BOX) {
		vec2 e = abs(q) - pr.shape.xy + pr.shape.z;
		vec2 sq = vec2(q.x < 0.0 ? -1.0 : 1.0, q.y < 0.0 ? -1.0 : 1.0);
		if (max(e.x, e.y) > 0.0) {
			vec2 o = max(e, 0.0);
			float l = max(length(o), 1e-12);
			d = l - pr.shape.z;
			g = sq * o / l;
		} else {
			d = max(e.x, e.y) - pr.shape.z;
			g = e.x > e.y ? vec2(sq.x, 0.0) : vec2(0.0, sq.y);
		}
	} else {
		vec2 sc = vec2(sin(pr.shape.z), cos(pr.shape.z));
		float sx = q.x < 0.0 ? -1.0 : 1.0;
		q.x = abs(q.x);
		if (sc.y * q.x > sc.x * q.y) {
			vec2 o = q - sc * pr.shape.x;
			float l = max(length(o), 1e-12);
			d = l - pr.shape.y;
			g = o / l;
		} else {
			float l = max(length(q), 1e-12);
			d = abs(l - pr.shape.x) - pr.shape.y;
			g = (l > pr.shape.x ? 1.0 : -1.0) * q / l;
		}
		g.x *= sx;
	}
	g = rot(ks) * (rot(pr.xf.z) * g);
	if ((pr.head.w & 1u) != 0u) {
		d = -d;
		g = -g;
	}
	return d;
}

// Contact of a disc (centre p, radius rad) with prim pr at time t: unit normal n
// (out of the surface), penetration pen > 0, surface velocity vs at the contact
// (rigid motion plus belt surface speed on the carrying face). False: no contact.
bool prim_contact(Prim pr, vec2 p, float t, float rad, out vec2 n, out float pen, out vec2 vs, out float ws) {
	n = vec2(0.0);
	pen = 0.0;
	vs = vec2(0.0);
	ws = 0.0;
	vec2 bpos, bvel;
	float bang, bom;
	body_pose(pr.head.y, t, bpos, bang, bvel, bom);
	vec2 rp = p - bpos;
	vec2 g;
	float d = prim_sdf_grad(pr, rot(-bang) * rp, g);
	if (d >= rad) return false;
	n = rot(bang) * g;
	pen = rad - d;
	vs = bvel + bom * vec2(-rp.y, rp.x);
	ws = bom;
	// Belt drive acts on the carrying (upper, flat) face only.
	vec2 up = rot(bang) * rot(pr.xf.z) * vec2(0.0, 1.0);
	if (dot(n, up) > 0.9) vs += pr.surf.w * vec2(up.y, -up.x);
	return true;
}
